{
  "name": "@janus-idp/backstage-plugin-rules-backend",
  "version": "0.1.2",
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "backstage": {
    "role": "backend-plugin"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "package.json": [
        "package.json"
      ]
    }
  },
  "scripts": {
    "build": "backstage-cli package build",
    "clean": "backstage-cli package clean",
    "export-dynamic": "janus-cli package export-dynamic-plugin",
    "lint": "backstage-cli package lint",
    "postpack": "backstage-cli package postpack",
    "postversion": "yarn run export-dynamic",
    "prepack": "backstage-cli package prepack",
    "start": "backstage-cli package start",
    "test": "backstage-cli package test --passWithNoTests --coverage",
    "tsc": "tsc"
  },
  "dependencies": {
    "@backstage/backend-common": "^0.25.0",
    "@backstage/backend-defaults": "^0.5.2",
    "@backstage/backend-plugin-api": "^1.0.1",
    "@backstage/backend-tasks": "^0.6.1",
    "@backstage/catalog-client": "^1.7.1",
    "@backstage/errors": "^1.2.4",
    "@backstage/integration": "^1.15.1",
    "@backstage/plugin-catalog-node": "^1.13.1",
    "@backstage/plugin-permission-common": "^0.8.1",
    "@backstage/plugin-permission-node": "^0.8.4",
    "@backstage/plugin-scaffolder-backend": "^1.26.2",
    "@backstage/plugin-scaffolder-node": "^0.5.0",
    "@urql/core": "^4.1.4",
    "ajv-formats": "^2.1.1",
    "cloudevents": "^8.0.0",
    "express": "^4.21.2",
    "express-promise-router": "^4.1.1",
    "fs-extra": "^10.1.0",
    "isomorphic-git": "^1.23.0",
    "moment": "^2.29.4",
    "openapi-backend": "^5.10.5",
    "yn": "^5.0.0"
  },
  "devDependencies": {
    "@backstage-community/plugin-rbac-common": "^1.12.1",
    "@backstage/backend-test-utils": "1.0.2",
    "@backstage/cli": "0.28.2",
    "@janus-idp/backstage-plugin-audit-log-node": "^1.7.1",
    "@janus-idp/cli": "1.19.1",
    "@types/express": "4.17.21",
    "@types/fs-extra": "11.0.4",
    "@types/json-schema": "7.0.15",
    "prettier": "3.4.2",
    "typescript": "^5.7.3"
  },
  "files": [
    "app-config.yaml",
    "dist",
    "dist-dynamic/*.*",
    "dist-dynamic/dist/**",
    "static"
  ],
  "configSchema": "config.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/janus-idp/backstage-plugins",
    "directory": "plugins/rules"
  },
  "keywords": [
    "backstage",
    "plugin"
  ]
}
